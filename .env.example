# Supabase project for the Shared Goals (rooms) feature.
# Copy this file to `.env` and fill in your project values.
# See supabase/README.md and docs/SharedGoals-Design.md
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: run the Group tab against the dumb in-memory backend instead of
# Supabase (no network, data resets on reload). Values: mock | supabase
VITE_SHARED_ROOMS_BACKEND=supabase
